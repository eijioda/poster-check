# --- 必須 ---
# OpenAIのAPIキー（https://platform.openai.com/api-keys で取得）
OPENAI_API_KEY=

# --- 任意 ---
# 使うモデル（既定: gpt-4o）
# OPENAI_MODEL=gpt-4o

# --- 本番デプロイ時のみ（アンケート回答の保存先） ---
# Vercelで「Upstash for Redis」を接続すると、この2つは自動で設定されます。
# 未設定ならローカルのファイル保存（data/）で動きます。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- 任意（Googleスプレッドシート連携） ---
# Apps Script の Web App URL。設定するとアンケート作成時にシートへ自動追記します。
# 手順は SETUP_SHEETS.md を参照。未設定なら連携はスキップされます。
# SHEETS_WEBHOOK_URL=
# SHEETS_TOKEN=
